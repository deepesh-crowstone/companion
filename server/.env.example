# Copy this file to .env (same folder). No quotes around values.
# Live voice in the app, and drawing companion profile pictures, still use xAI.
# The Alakh Sir bot starts without this key.
# Get key: https://console.x.ai/team/default/api-keys
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=any-long-random-string-at-least-32-chars
XAI_CHAT_MODEL=grok-4.7
# Text, voice-note, student-photo, and board-check replies. OpenAI-compatible chat completions.
# Live voice and companion profile pictures still use xAI.
REPLY_API_BASE_URL=http://103.48.50.181:6006/v1
REPLY_API_KEY=your_reply_api_key
REPLY_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# Voice notes use xAI STT + Grok reply + ElevenLabs TTS by default.
# Use text_tagged to experiment with normal text-chat chunks joined into voice notes.
MIA_VOICE_REPLY_PIPELINE=voice
MIA_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0
ELEVENLABS_SPEAKER_BOOST=true
# xAI voice fallback when MIA_TTS_PROVIDER=xai, and realtime calls.
MIA_VOICE_ID=eve
# Voice notes: Hindi voice/accent for Devanagari Hindi replies (xAI BCP-47).
MIA_TTS_LANGUAGE=hi
MIA_STT_LANGUAGE=hi
PORT=3000
HOST=0.0.0.0

# PostgreSQL (local example)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mia

# Railway Bucket — required for voice notes and private-mode photos (same bucket).
# BUCKET=my-bucket-xxxxx
# ENDPOINT=https://storage.railway.app
# REGION=auto
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# After bucket is configured, upload gallery once: npm run seed:zara-photos
# Objects: voice/* (recordings), photos/zara/*.jpg (Zara private chat photos)

# Cashfree Payment Gateway (personality pass)
# Dashboard: https://merchant.cashfree.com/merchants/pg/developers/api-keys
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional: webhook URL (e.g. https://api.chatlife.online/personalities/webhook)
# CASHFREE_NOTIFY_URL=

# Scripted call preview clips — JSON array of hosted MP3 URLs, played in order.
# Change on Railway (or .env) without an app update; the app fetches this list on each call tap.
# CALL_PREVIEW_AUDIO_URLS=["https://cdn.example.com/zara/call_1.mp3","https://cdn.example.com/zara/call_2.mp3"]

# Push notifications (Firebase Cloud Messaging)
# Create a Firebase project, enable Cloud Messaging, and generate a service account key.
# Paste the full JSON object as a single line (Railway / production env var).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Open Telegram bot for Riva (@riva_pwtalk_bot). Token from @BotFather, no Bearer prefix.
# The production server registers https://api.chatlife.online/telegram/webhook on boot.
# TELEGRAM_BOT_TOKEN=
# Optional override for the public API origin, without a trailing path.
# TELEGRAM_WEBHOOK_BASE_URL=https://api.chatlife.online
# Optional explicit webhook secret. When unset, a hash of the bot token is used.
# TELEGRAM_WEBHOOK_SECRET=

# Open Telegram bot for Alakh Sir (@alakhpandeysir1Bot). Separate token from Riva.
# The production server registers https://api.chatlife.online/telegram/alakh/webhook on boot.
# TELEGRAM_ALAKH_BOT_TOKEN=
# TELEGRAM_ALAKH_WEBHOOK_SECRET=
# Alakh Sir voice notes. OpenAI-style speech API on the LoRA GPU. Ogg Opus in, Telegram voice out.
# A student's voice note is answered with a voice note. Typed messages stay text.
# When unset, voice notes are answered as text too.
# Student photos are read by the reply model with thinking off. The longest side is shrunk to 1024 pixels.
# A printed numerical can take a few minutes. A solved question is one rich message with LaTeX,
# then a white-canvas explanation video in Alakh Sir's voice when ALAKH_TTS_URL is set.
# Pictures in that video are Recraft V4.1 Flash through OpenRouter. Equations and sentences
# are drawn by the video, not by the image model. When unset, the video is words and math only.
# OPENROUTER_API_KEY=
# Slide videos write the explanation first, then cut it into still plates with a writing well.
# Unset keeps the two-column page. Set to 1 to try slides. A failed slide video falls back to the page.
# ALAKH_VIDEO_SLIDES=
# Board videos let the image model draw each whole board: diagram, Hindi, and equations.
# A vision check on the reply model reads every board back, with thinking off. A wrong diagram is erased.
# A wrong written line is corrected once, then written by our renderer if it is still wrong.
# Lines are revealed while Alakh Sir explains them.
# Unset keeps the current video. Set to 1 to try boards. A failed board video falls back
# to slides when ALAKH_VIDEO_SLIDES=1, then to the page.
# ALAKH_VIDEO_BOARD=
# ALAKH_BOARD_IMAGE_MODEL=openai/gpt-image-2
# ALAKH_TTS_URL=http://<alakh-tts-host>:6006/v1/audio/speech
# ALAKH_TTS_API_KEY=

# Telegram voice notes. OpenAI-compatible transcriptions API.
# Multipart fields: file, model, language. The transcript is the JSON text field.
# TELEGRAM_STT_URL=http://43.242.226.64:6006/v1/audio/transcriptions
# TELEGRAM_STT_API_KEY=
# TELEGRAM_STT_MODEL=Qwen/Qwen3-ASR-1.7B
# TELEGRAM_STT_LANGUAGE=Auto

# Free daily message limit — non-paying users get this many text messages per
# day before the paywall. Change on Railway (or .env) without an app update;
# the app fetches it on launch via GET /config. Default 5. Set 0 to gate every
# free user immediately.
# FREE_DAILY_MESSAGE_LIMIT=5

# Pass pricing — returned by GET /config and payment status endpoints. Change on
# Railway without an app update; the app reads these values for all paywall UI.
# PRIVATE_MODE_PASS_PRICE_INR=99
# PRIVATE_MODE_PASS_STRIKE_PRICE_INR=1499
# PERSONALITY_PASS_PRICE_INR=49
# PERSONALITY_PASS_STRIKE_PRICE_INR=299

# AI profile factory — review dashboard at /admin. Any long random string;
# the dashboard asks for it once and stores it in the browser.
# ADMIN_TOKEN=
